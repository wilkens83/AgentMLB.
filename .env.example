# Copy to .env and fill in real values. NEVER commit the real .env.

# Supabase PostgreSQL connection string (Project Settings -> Database -> Connection string)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Supabase project (used by client-side integrations / edge functions if needed)
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_KEY=your-anon-or-service-role-key

# LLM provider key for the Text-to-SQL agent (litellm routes by model name).
# Use OPENAI_API_KEY for gpt-* models, or ANTHROPIC_API_KEY for claude-* models.
OPENAI_API_KEY=your-openai-key
# ANTHROPIC_API_KEY=your-anthropic-key

# Agent + safety tunables (optional; defaults shown)
MLB_AGENT_MODEL=gpt-4o
STATEMENT_TIMEOUT_MS=5000
MAX_ROWS=1000
DB_MAX_CONN=10
